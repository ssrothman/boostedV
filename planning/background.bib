@article{OPAL:1998ixj,
  title = {\$\textbackslash mathrm\{{{W}}\textasciicircum +{{W}}\textasciicircum -\}\$production and Triple Gauge Boson Couplings at {{LEP}} Energies up to 183 {{GeV}}},
  author = {Abbiendi et al., G. and {The Opal Collaboration}},
  date = {1999-04-01},
  journaltitle = {European Physical Journal C: Particles and Fields},
  shortjournal = {Eur. Phys. J. C},
  volume = {8},
  number = {2},
  pages = {191--215},
  issn = {1434-6052},
  doi = {10.1007/s100529901106},
  url = {https://doi.org/10.1007/s100529901106},
  urldate = {2026-11-09},
  abstract = {A study of W-pair production in \$\{\textbackslash rm e\textasciicircum +e\textasciicircum -\}\$annihilations at LEP is presented, based on \$877\textbackslash,\{\textbackslash rm W\textasciicircum +W\textasciicircum -\}\$candidates corresponding to an integrated luminosity of 57 pb\$\textasciicircum\{-1\}\$at \$\textbackslash sqrt s=183\$GeV. Assuming that the angular distributions of the W-pair production and decay, as well as their branching fractions, are described by the Standard Model, the W-pair production cross-section is measured to be \$15.43\textbackslash pm 0.61 (\{\textbackslash rm stat.\}) \textbackslash pm 0.26 (\{\textbackslash rm syst.\})\$pb. Assuming lepton universality and combining with our results from lower centre-of-mass energies, the W branching fraction to hadrons is determined to be \$67.9 \textbackslash pm 1.2 (\{\textbackslash rm stat.\})\textbackslash pm 0.5 (\{\textbackslash rm syst.\})\$\%. The number of W-pair candidates and the angular distributions for each final state (\$\{\textbackslash rm q \textbackslash bar q\} \textbackslash bar \textbackslash ell \textbackslash nu\_\textbackslash ell\$, \$\{\textbackslash rm q \textbackslash bar q q \textbackslash bar q\}, \textbackslash bar \textbackslash ell \textbackslash nu\_\textbackslash ell \textbackslash ell\textasciicircum\textbackslash prime \textbackslash bar \textbackslash nu\_\{\textbackslash ell\textasciicircum\textbackslash prime \})\$are used to determine the triple gauge boson couplings. After combining these values with our results from lower centre-of-mass energies we obtain \$\textbackslash Delta \textbackslash kappa\_\textbackslash gamma = 0.11\textasciicircum\{+0.52\}\_\{-0.37\}\$, \$\textbackslash Delta g\textasciicircum\{\textbackslash rm z\}\_1 = 0.01\textasciicircum\{+ 0.13\}\_\{-0.12\}\$and \$\textbackslash lambda = -0.10\textasciicircum\{+0.13\}\_\{-0.12\}\$, where the errors include both statistical and systematic uncertainties and each coupling is determined by setting the other two couplings to the Standard Model value. The fraction of W bosons produced with a longitudinal polarisation is measured to be \$0.242 \textbackslash pm 0.091(\{\textbackslash rm stat.\}) \textbackslash pm 0.023 (\{\textbackslash rm syst.\})\$. All these measurements are consistent with the Standard Model expectations.},
  langid = {english},
  keywords = {Angular Distribution,Gauge Boson,Longitudinal Polarisation,Model Expectation,Systematic Uncertainty},
  file = {C:\Users\simon\Zotero\storage\DTGQRT9C\Abbiendi et al. and The Opal Collaboration - 1999 - $mathrm W^+W^- $production and triple gauge boson couplings at LEP energies up to 183 GeV.pdf}
}
@article{L3:1999cbg,
  title = {Direct Observation of Longitudinally Polarised {{W}} Bosons},
  author = {Collaboration, L3},
  date = {2000-02},
  journaltitle = {Physics Letters B},
  shortjournal = {Phys. Lett. B},
  volume = {474},
  number = {1--2},
  eprint = {hep-ex/0001016},
  eprinttype = {arXiv},
  pages = {194--204},
  issn = {03702693},
  doi = {10.1016/S0370-2693(99)01489-6},
  url = {http://arxiv.org/abs/hep-ex/0001016},
  urldate = {2026-11-09},
  abstract = {The three different helicity states of W bosons, produced in the reaction e+e- -{$>$} W+W- -{$>$} l nu q q\textasciitilde{} are studied using leptonic and hadronic W decays at sqrt\{s\}=183GeV and 189GeV. The W polarisation is also measured as a function of the scattering angle between the W- and the direction of the e- beam. The analysis demonstrates that W bosons are produced with all three helicities, the longitudinal and the two transverse states. Combining the results from the two center-of-mass energies and with leptonic and hadronic W decays, the fraction of longitudinally polarised W bosons is measured to be 0.261 +/- 0.051(stat.) +/- 0.016(syst.) in agreement with the expectation from the Standard Model.},
  langid = {english},
  keywords = {High Energy Physics - Experiment},
  file = {C\:\\Users\\simon\\Zotero\\storage\\FD3NEBXP\\Collaboration - 2000 - Direct observation of longitudinally polarised W bosons.pdf;C\:\\Users\\simon\\Zotero\\storage\\CQ7L3M4P\\0001016.html}
}

@article{OPAL:2000wbs,
  title = {Measurement of {{W}} Boson Polarisations and {{CP}}-Violating Triple Gauge Couplings from {{W}}+{{W}}- Production at {{LEP}}},
  author = {Collaboration, The OPAL and Abbiendi, G.},
  date = {2001-02},
  journaltitle = {The European Physical Journal C},
  shortjournal = {Eur. Phys. J. C},
  volume = {19},
  number = {2},
  eprint = {hep-ex/0009021},
  eprinttype = {arXiv},
  pages = {229--240},
  issn = {1434-6044, 1434-6052},
  doi = {10.1007/s100520100602},
  url = {http://arxiv.org/abs/hep-ex/0009021},
  urldate = {2026-11-09},
  abstract = {Measurements are presented of the polarisation of W+W- boson pairs produced in e+e- collisions, and of CP-violating WWZ and WWGamma trilinear gauge couplings. The data were recorded by the OPAL experiment at LEP during 1998, where a total integrated luminosity of 183 pb\textasciicircum -1 was obtained at a centre-of-mass energy of 189 GeV. The measurements are performed through a spin density matrix analysis of the W boson decay products. The fraction of W bosons produced with longitudinal polarisation was found to be sigma\_L/sigma\_total = (21.0 +- 3.3 +- 1.6)\% where the first error is statistical and the second systematic. The joint W boson pair production fractions were found to be sigma\_TT/sigma\_total = (78.1 +- 9.0 +- 3.2) \%, sigma\_LL/sigma\_total = (20.1 +- 7.2 +- 1.8) \% and sigma\_TL/sigma\_total = (1.8 +- 14.7 +- 3.8) \%. In the CP-violating trilinear gauge coupling sector we find kappa\_z = -0.20 +0.10 -0.07, g\textasciicircum z\_4 = -0.02 +0.32 -0.33 and lambda\_z = -0.18 +0.24 -0.16, where errors include both statistical and systematic uncertainties. In each case the coupling is determined with all other couplings set to their Standard Model values except those related to the measured coupling via SU(2)\_LxU(1)\_Y symmetry. These results are consistent with Standard Model expectations.},
  langid = {english},
  keywords = {High Energy Physics - Experiment},
  file = {C\:\\Users\\simon\\Zotero\\storage\\JAFHBKSH\\Collaboration and Abbiendi - 2001 - Measurement of W boson polarisations and CP-violating triple gauge couplings from W+W- production at.pdf;C\:\\Users\\simon\\Zotero\\storage\\RG45CS2X\\0009021.html}
}

