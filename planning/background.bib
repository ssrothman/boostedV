@article{CDF:2012odc,
  title = {W Boson Polarization Measurement in the Ttbar Dilepton Channel Using the {{CDF II}} Detector},
  author = {Collaboration, C. D. F.},
  date = {2013-05},
  journaltitle = {Physics Letters B},
  shortjournal = {Phys. Lett. B},
  volume = {722},
  number = {1--3},
  eprint = {1205.0354},
  eprinttype = {arXiv},
  eprintclass = {hep-ex},
  pages = {48--54},
  issn = {03702693},
  doi = {10.1016/j.physletb.2013.03.032},
  url = {http://arxiv.org/abs/1205.0354},
  urldate = {2026-11-10},
  abstract = {We present a measurement of \$W\$ boson polarization in top-quark decays in \$t\textbackslash bar\{t\}\$ events with decays to dilepton final states using \$5.1 \{\textbackslash rm fb\textasciicircum\{-1\}\}\$ of integrated luminosity in \$p\textbackslash bar\{p\}\$ collisions collected by the CDF II detector at the Tevatron. A simultaneous measurement of the fractions of longitudinal (\$f\_0\$) and right-handed (\$f\_+\$) \$W\$ bosons yields the results \$f\_0 = 0.71 \textasciicircum\{+0.18\}\_\{-0.17\} \{\textbackslash rm (stat)\} \textbackslash pm 0.06 \{\textbackslash rm (syst)\}\$ and \$f\_+ = -0.07 \textbackslash pm 0.09 \{\textbackslash rm (stat)\} \textbackslash pm 0.03 \{\textbackslash rm (syst)\}\$. Combining this measurement with our previous result based on single lepton final states, we obtain \$f\_0 = 0.84 \textbackslash pm 0.09 \{\textbackslash rm (stat)\} \textbackslash pm 0.05 \{\textbackslash rm (syst)\}\$ and \$f\_\{+\} = -0.16 \textbackslash pm 0.05 \{\textbackslash rm (stat)\} \textbackslash pm 0.04 \{\textbackslash rm (syst)\}\$. The results are consistent with standard model expectation.},
  langid = {english},
  keywords = {High Energy Physics - Experiment},
  file = {C\:\\Users\\simon\\Zotero\\storage\\YHXC5G2P\\Collaboration - 2013 - W boson polarization measurement in the ttbar dilepton channel using the CDF II detector.pdf;C\:\\Users\\simon\\Zotero\\storage\\6QIA8AMS\\1205.html}
}

@article{CDF:2006buc,
  title = {Measurement of the Helicity Fractions of {{W}} Bosons from Top Quark Decays Using Fully Reconstructed Top-Antitop Events with {{CDF II}}},
  author = {Collaboration, Cdf Ii},
  date = {2007-03-15},
  journaltitle = {Physical Review D},
  shortjournal = {Phys. Rev. D},
  volume = {75},
  number = {5},
  eprint = {hep-ex/0612011},
  eprinttype = {arXiv},
  pages = {052001},
  issn = {1550-7998, 1550-2368},
  doi = {10.1103/PhysRevD.75.052001},
  url = {http://arxiv.org/abs/hep-ex/0612011},
  urldate = {2026-11-10},
  abstract = {We present a measurement of the fractions F\_0 and F\_+ of longitudinally polarized and right-handed W bosons in top quark decays using data collected with the CDF II detector. The data set used in the analysis corresponds to an integrated luminosity of approximately 318 pb -1. We select ttbar candidate events with one lepton, at least four jets, and missing transverse energy. Our helicity measurement uses the decay angle theta*, which is defined as the angle between the momentum of the charged lepton in the W boson rest frame and the W momentum in the top quark rest frame. The cos(theta*) distribution in the data is determined by full kinematic reconstruction of the ttbar candidates. We find F\_0 = 0.85 +0.15 -0.22 (stat) +- 0.06 (syst) and F\_+ = 0.05 +0.11 -0.05 (stat) +- 0.03 (syst), which is consistent with the standard model prediction. We set an upper limit on the fraction of right-handed W bosons of F\_+ {$<$} 0.26 at the 95\% confidence level.},
  langid = {english},
  keywords = {High Energy Physics - Experiment},
  file = {C\:\\Users\\simon\\Zotero\\storage\\WER2IF56\\Collaboration - 2007 - Measurement of the helicity fractions of W bosons from top quark decays using fully reconstructed to.pdf;C\:\\Users\\simon\\Zotero\\storage\\6KPFY8W8\\0612011.html}
}

