@article{CDF:2010cnn,
  title = {Measurement of {{W}}-Boson Polarization in Top-Quark Decay in Ppbar Collisions at Sqrt(s) = 1.96 {{TeV}}},
  author = {Collaboration, The CDF and Aaltonen, T.},
  date = {2010-07-23},
  journaltitle = {Physical Review Letters},
  shortjournal = {Phys. Rev. Lett.},
  volume = {105},
  number = {4},
  eprint = {1003.0224},
  eprinttype = {arXiv},
  eprintclass = {hep-ex},
  pages = {042002},
  issn = {0031-9007, 1079-7114},
  doi = {10.1103/PhysRevLett.105.042002},
  url = {http://arxiv.org/abs/1003.0224},
  urldate = {2026-11-10},
  abstract = {We report measurements of the polarization of W bosons from top-quark decays using 2.7 fb\textasciicircum -1 of ppbar collisions collected by the CDF II detector. Assuming a top-quark mass of 175 GeV/c\textasciicircum 2, three measurements are performed. A simultaneous measurement of the fraction of longitudinal (f\_0) and right-handed (f\_+) W bosons yields the model-independent results f\_0 = 0.88 \textbackslash pm 0.11 (stat) \textbackslash pm 0.06 (syst) and f\_+ = -0.15 \textbackslash pm 0.07 (stat) \textbackslash pm 0.06 (syst) with a correlation coefficient of -0.59. A measurement of f\_0 (f\_+) constraining f\_+ (f\_0) to its standard model value of 0.0 (0.7) yields f\_0 = 0.70 \textbackslash pm 0.07 (stat) \textbackslash pm 0.04 (syst) (f\_+ = -0.01 \textbackslash pm 0.02 (stat) \textbackslash pm 0.05 (syst)). All these results are consistent with standard model expectations.},
  langid = {english},
  keywords = {High Energy Physics - Experiment},
  file = {C\:\\Users\\simon\\Zotero\\storage\\FWK8DZLN\\Collaboration and Aaltonen - 2010 - Measurement of W-boson polarization in top-quark decay in ppbar collisions at sqrt(s) = 1.96 TeV.pdf;C\:\\Users\\simon\\Zotero\\storage\\PIG2GH5X\\1003.html}
}

